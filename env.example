# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Auth
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# 32-byte hex (generate: openssl rand -hex 32)
API_KEY_ENC_KEY=

# Supabase (service role — server-only, never expose)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# First-run only: provision a master key. Set this BEFORE first start, then
# remove from the env once the server logs "provisioned master API key".
# Format: "rex_" followed by 16+ url-safe characters. Generate with:
#   node -e "console.log('rex_' + require('crypto').randomBytes(32).toString('base64url'))"
MASTER_API_KEY_BOOTSTRAP=

# Comma-separated origins or "*"
CORS_ORIGINS=*

# Trusted proxy whitelist for X-Forwarded-* (req.ip).
# Default trusts only private/loopback hops (safe behind nginx/docker/Cloudflare).
# Use "*" only when NOTHING public-facing reaches Fastify directly.
TRUSTED_PROXIES=loopback,linklocal,uniquelocal

# Quotas
ANON_DAILY_QUOTA=100
USER_DAILY_QUOTA=1000

# ─── Auth Hot-Path Cache (in-process) ───────────────────────────────
# How long (seconds) a validated API key is cached so repeat requests
# skip the per-request DB lookup. Revokes/updates take effect immediately
# on the issuing instance and converge within this window elsewhere.
# Set 0 to disable record caching. Default: 30.
API_KEY_CACHE_TTL_SEC=30

# Max distinct API-key records held in the in-process auth cache.
# Default: 5000.
API_KEY_CACHE_MAX=5000

# Throttle window (seconds) for last_used_at writes per key — collapses
# the per-request UPDATE into at most one write per key per window.
# Set 0 to write on every request (legacy behaviour). Default: 60.
API_KEY_TOUCH_THROTTLE_SEC=60

# Simpan API key user ter-enkripsi agar bisa di-reveal lagi via dashboard
# (POST /api/me/key/reveal). Set false untuk hash-only (reveal → 404).
API_KEY_REVEALABLE=true

# ─── Chromium / Page Pool ───────────────────────────────────────────
# Optional override for Chromium executable path. Playwright uses its
# bundled binary when omitted.
# CHROME_BIN=

# Number of persistent BrowserContexts kept in the pool (1–32).
# Each slot ≈ one concurrent render. 4 is safe for 1-GiB containers;
# bump to 8 on 2-GiB+.
PAGE_POOL_SIZE=4

# Max time (ms) a request waits for a free pool slot before 503-ing.
# Keep shorter than client-visible timeout so users see "server busy"
# instead of a generic gateway timeout.
PAGE_POOL_ACQUIRE_TIMEOUT_MS=15000

# ─── Static Assets ─────────────────────────────────────────────────
# Optional: path to the static landing page directory. Defaults to
# "<cwd>/public". Override this when the binary is launched from a path
# other than the project root (e.g., custom container layouts).
# STATIC_DIR=

# ─── Shortlinks ────────────────────────────────────────────────────
# Optional dedicated domain for generated shortlinks, e.g.
# https://short.example.com (no trailing slash). When set, short_url uses
# this origin at the ROOT path and redirect is also served from "/".
# Leave empty to use the API request host (/s/<slug>).
# SHORTLINK_BASE_URL=https://short.example.com


# ─── Download Proxy ─────────────────────────────────────────────────
# TTL for signed proxy download tokens (seconds). After expiry the
# token can no longer be used to stream. Default: 3600 (1 hour).
DOWNLOAD_PROXY_TTL_SEC=3600

# Max bytes the proxy will stream per request. Prevents abuse.
# Default: 104857600 (100 MB).
DOWNLOAD_MAX_BYTES=104857600

# ─── Downloaders (cobalt / yt-dlp) ──────────────────────────────────
# Cobalt API base URL for Instagram/YouTube downloads. The public instance
# is rate-limited + bot-protected — self-host for reliability:
#   docker run -d -p 9000:9000 ghcr.io/imputnet/cobalt:latest
# then set COBALT_API_URL=http://localhost:9000/
COBALT_API_URL=https://api.cobalt.tools/

# (opsional) host internal tambahan yang boleh di-stream proxy meski IP privat.
# Host COBALT_API_URL sudah diizinkan otomatis.
DOWNLOAD_PROXY_ALLOW_HOSTS=

# Path to a yt-dlp cookies file (Netscape format), used as a YouTube
# fallback when cobalt fails. Relative to cwd or an absolute path.
# (Note: cookies.txt is gitignored — never commit real cookies.)
YTDLP_COOKIES_PATH=./cookies.txt

# ─── Audio Loudness ─────────────────────────────────────────────────
# ffmpeg `-af` chain for extracted audio (TikTok → MP3). Empty = default
# di ytdlp.ts. Saat di-set, OVERRIDE default kode (tune di sini + restart).
AUDIO_LOUDNESS_FILTER=

# ─── AI — Gemini ────────────────────────────────────────────────────
# Comma-separated Gemini API keys untuk rotation otomatis.
# Dipakai oleh: skinfilter (skin darkening)
# Generate di: https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=

# ─── AI — Groq ──────────────────────────────────────────────────────
# Comma-separated Groq API keys untuk rotation otomatis.
# Dipakai oleh: STT (Whisper), translate, imagegen (auto negative prompt + translate prompt)
# Generate di: https://console.groq.com/keys
GROQ_API_KEYS=

# ─── AI — Cloudflare Workers AI ─────────────────────────────────────
# URL dan API key untuk Cloudflare Worker image generator.
# Deploy worker dari: https://github.com/saurav-z/free-image-generation-api
CF_WORKER_URL=
CF_WORKER_API_KEY=

# ─── GeoIP (MaxMind GeoLite2) ───────────────────────────────────────
# Path ke file database MaxMind GeoLite2 (.mmdb).
# Download gratis di: https://www.maxmind.com/en/geolite2/signup
# Taruh di folder data/ lalu isi path di bawah.
GEOIP_CITY_DB=./data/GeoLite2-City.mmdb
GEOIP_ASN_DB=./data/GeoLite2-ASN.mmdb
