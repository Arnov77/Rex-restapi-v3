{
  "name": "rex-api",
  "version": "3.0.0",
  "description": "Rex REST API — Fastify + TypeScript backend (WhatsApp bot oriented)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && npm run copy-assets",
    "copy-assets": "cp -r src/modules/makers/brat/assets dist/modules/makers/brat/ && cp -r src/modules/makers/smeme/assets dist/modules/makers/smeme/ && cp -r src/modules/makers/achievement/assets dist/modules/makers/achievement/ && cp -r src/modules/makers/miq/assets dist/modules/makers/miq/ && (cp -r data/ dist/ 2>/dev/null || true)",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/sensible": "^6.0.1",
    "@fastify/static": "^8.0.3",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^5.1.0",
    "@fastify/under-pressure": "^9.0.1",
    "@google/genai": "^2.8.0",
    "@gradio/client": "^2.2.2",
    "@maxmind/geoip2-node": "^6.3.4",
    "@supabase/supabase-js": "^2.105.4",
    "@types/qrcode": "^1.5.6",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "bootstrap-icons": "^1.13.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "gifenc": "^1.0.3",
    "groq-sdk": "^1.2.1",
    "jsonwebtoken": "^9.0.2",
    "mime": "^4.1.0",
    "minecraft-icon-items": "^0.4.5",
    "msedge-tts": "^2.0.5",
    "music-metadata": "^11.13.0",
    "openai": "^7.4.0",
    "pino-pretty": "^11.3.0",
    "playwright-core": "^1.60.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "undici": "^7.26.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.1",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
